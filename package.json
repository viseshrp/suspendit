{
  "name": "suspendit",
  "description": "Suspend tabs, groups, and windows with Chrome native tab discarding.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "icons:generate": "node scripts/generate-icons.mjs",
    "quality": "pnpm compile && pnpm lint",
    "smoke": "pnpm build && node scripts/smoke.mjs",
    "package": "pnpm zip && node scripts/smoke.mjs --package",
    "postinstall": "wxt prepare",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.12",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.1.36",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.4",
    "jsdom": "^24.1.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.4",
    "wxt": "^0.20.6"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  }
}
